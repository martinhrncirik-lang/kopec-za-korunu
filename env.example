# Vzor proměnných. Skutečné hodnoty patří do Vercel → Project → Settings → Environment Variables.
# Tento soubor neobsahuje žádná tajemství a může být v GitHubu.

# Adresa aplikace, kterou přidělí Vercel (bez lomítka na konci)
APP_URL=https://kopec-za-korunu.vercel.app

# Strava → strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Libovolné vymyšlené heslo pro ověření webhooku (stejné použijete při registraci webhooku)
STRAVA_VERIFY_TOKEN=
# Doplní se po registraci webhooku (číslo "id" z odpovědi Stravy)
STRAVA_SUBSCRIPTION_ID=

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Náhodný řetězec min. 32 znaků (podepisuje přihlašovací cookie)
SESSION_SECRET=
# Náhodný řetězec (Vercel ho posílá při spuštění měsíčního výpisu)
CRON_SECRET=

# Push notifikace: vygenerujte příkazem  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=martin.hrncirik@gmail.com

# Dary
DONATION_IBAN=CZ7103000000000000663939
DONATION_ACCOUNT_LABEL=663939/0300
RATE_CZK_PER_KM=1
